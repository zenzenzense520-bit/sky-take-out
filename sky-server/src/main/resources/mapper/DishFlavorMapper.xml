<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.mapper.DishFlavorMapper">

    <!-- 批量插入口味 -->
    <insert id="insertBatch">
        insert into dish_flavor (dish_id, name, value, create_time, update_time, create_user, update_user)
        values
        <foreach collection="flavors" item="df" separator=",">
            (#{df.dishId}, #{df.name}, #{df.value},
             coalesce(#{df.createTime}, now()),
             coalesce(#{df.updateTime}, now()),
             coalesce(#{df.createUser}, 1),
             coalesce(#{df.updateUser}, 1))
        </foreach>
    </insert>

    <!-- 根据菜品 id 删除口味 -->
    <delete id="deleteByDishId">
        delete from dish_flavor where dish_id = #{dishId}
    </delete>

    <!-- 批量删除菜品口味 -->
    <delete id="deleteByDishIds">
        delete from dish_flavor where dish_id in
        <foreach collection="dishIds" item="dishId" open="(" separator="," close=")">
            #{dishId}
        </foreach>
    </delete>

    <!-- 根据菜品 id 查询口味列表 -->
    <select id="getByDishId" resultType="com.sky.entity.DishFlavor">
        select * from dish_flavor where dish_id = #{dishId}
    </select>

</mapper>
